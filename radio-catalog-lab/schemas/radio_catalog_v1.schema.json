{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grosses-ondes.fr/schemas/radio_catalog_v1.schema.json",
  "title": "Grosses Ondes central radio catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "release_sequence",
    "generated_at",
    "stations",
    "tombstones"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "const": "grosses-ondes-radio"
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    }
  },
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go_station_id",
        "display_name",
        "country_code",
        "genres",
        "radio_browser_uuids",
        "legacy_aliases",
        "status",
        "streams",
        "logo",
        "editorial"
      ],
      "properties": {
        "go_station_id": {
          "type": "string",
          "pattern": "^go-station-[0-9]{6,}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "genres": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "radio_browser_uuids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/radioBrowserId"
          }
        },
        "legacy_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          }
        },
        "logo": {
          "anyOf": [
            {
              "$ref": "#/$defs/logo"
            },
            {
              "type": "null"
            }
          ]
        },
        "editorial": {
          "$ref": "#/$defs/editorial"
        }
      }
    },
    "radioBrowserId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "state"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "current",
            "historical"
          ]
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "changed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "quarantined",
            "retired"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_ref": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "url",
        "priority",
        "protocol",
        "state"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "enum": [
            "http",
            "https"
          ]
        },
        "codec": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "bitrate_kbps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "state": {
          "enum": [
            "candidate",
            "candidate_verified",
            "verified",
            "suspected_unavailable",
            "disabled"
          ]
        },
        "last_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "previous_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision",
        "url",
        "sha256",
        "byte_size",
        "width",
        "height",
        "mime_type"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_state",
        "reviewed_at",
        "evidence_refs"
      ],
      "properties": {
        "admission_state": {
          "enum": [
            "approved",
            "legacy_preserved"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go_station_id",
        "legacy_aliases",
        "retired_at",
        "reason_code"
      ],
      "properties": {
        "go_station_id": {
          "type": "string",
          "pattern": "^go-station-[0-9]{6,}$"
        },
        "legacy_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retired_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
