{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grosses-ondes.fr/schemas/radio_catalog_pointer_v1.schema.json",
  "title": "Grosses Ondes central radio catalog publication pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "release_sequence",
    "published_at",
    "content_sha256",
    "content_length",
    "content_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "const": "grosses-ondes-radio"
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "content_path": {
      "type": "string",
      "pattern": "^releases/[a-f0-9]{64}\\.json$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature_base64": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  }
}
